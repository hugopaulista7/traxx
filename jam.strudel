setcpm(125/4)

_KICK1: s("bd:1").bank("TR808").beat(`<[0,1,7,10]!3 [0,1,7,9,10]>`, 16).velocity(.9).dec(.8).duck("2:3:4")

_KICK2: s("bd:1*4").bank("TR808").velocity(.9).dec(.8).duck("2:3:4").coarse(4)
// .rib(0,1/2)
  // .duckatt(.125).duckdepth(.8)

// snare: s("sd:3").beat("2,6",8).postgain(.9).att(0.03)
// cp: s("cp:1").beat("2,6", 8).postgain(.9)

_sn: s("sd:3*2").gain(.5).dec(.5)

_shaker: s("sh").beat("6,7",8).room(4)

_oh: s("oh").beat("1,3,5,7",8).postgain(.5).clip(.4)



_organ: s("gm_church_organ").note("[a,c,e]@32")
  .rel(4).dec(4)
  .sus(4)
  .legato(4.5)
  .att(.3)
  .postgain(.5)
  .orbit(4)
  .gain(.4)
  .velocity(.7)
  .lpf(400)
  // .superimpose((x => x.add(2)))
  // .att()


_stab: s("triangle").note("[a,c,e]*3 [c,g,eb]".add(24))
  .vibrato(.02)
  .superimpose(x => x.add(3))
  .superimpose(x => x.add(7))
  .seg(16)
  .bpf(5000).bpenv(12).gain(.4)
  .clip(.6)

_bass: note(`<
[0 ~ 0 0]
[~ ~ 3 0]
[5 ~ 7 0]
>`.sub(16))
  .seg(4)
  .scale("A:major")
  .lpf(slider(52.5, 0, 3500))
  // .lpq(20)
  .lpenv(12)
  .orbit(2)
  .clip(1.4)
  .gain(1)
  .fast(2)
  .s("saw")
  .detune(2)
  .coarse(2)
  .rib(0,1/2)

_riser: s("pulse").orbit(4).seg(16)
  .dec(.1).fm(time).fmh(time).velocity(.6).clip(.5)
  .room(slider(2.544, 0, 3))


_$:s("gm_synth_strings_1").seg(2)
  .note(irand(16).sub(5)).scale("A:major").orbit(3).bpf(500).bpenv(-12)
.room(2).roomdim(3).clip(.5).superimpose(x => x.sub(2))