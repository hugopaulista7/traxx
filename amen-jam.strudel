// "amen jam"
// @by ndr_id
samples('github:yaxu/clean-breaks')

setcpm(170/ 4 )

all(x => x.postgain(.9))


$: s("amen/4").fit().chop(32)
  .rib(1, 1/1)
  .room(2).roomsize(.8).delay(1)
  .hpf(3000)
  ._punchcard({height: 120, width: 1200})

_$: s("bd:4").beat("0, 10",16).gain(.8).duck("2:3:4").duckatt(.24)._punchcard({width:1200, height: 20})

_$: s("sd:8").beat("4,12",16).gain(.8)
  // .room(4).roomsize(.7).hpf(3000)

_$: s("hh:1").beat("0,1,3,4,6,7,9,10,12,13,15", 16).gain(.9)

_$: s("pulse").note(irand(8)).seg(16).lpf(1200).lpenv(3).fm(time).fmh(time).room(1).roomsize(.3).clip(.3).orbit(2)._punchcard()

_$: note(`<b2 e2 g2 e2>`).slow(2).s("supersaw").att(.25).fm(.5).fmh(.9).slow(4).detune(.5)
  // .rib(0, 1/8)
  // .seg(`<4 2 8 4>`)
  .orbit(4).lpf(1200).lpenv(7)._punchcard({})


_sub: note("g2").sound("sine").beat("0,10",16).orbit(2).gain(.8).clip(4)
