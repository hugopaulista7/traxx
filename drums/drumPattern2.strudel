// "electro break drums 2"

// @by hvgo

const bankName = "TR909"

$kick: bank(bankName).s("bd:5")
  .beat("0,1.5,3,5",8).gain(.8)
  .clip(.8)
  .resonance(.3).duck(2).duckatt(.2)

$snare: bank("TR808").s("sd:4").beat("2,6",8).gain(.9)

$cb: bank("TR808").s("cb:2").beat("7", 8).gain(1)


$sub: s("sine").note("g1 g1 c2").beat("0,1.5,3",8)
  .clip(2)
  .gain(.7).orbit(2)._scope()
$hh: bank("TR808").s("hh").beat("0,2,3,5,6,8,9,11,12,14,15",16)
  .velocity("0.6 0.9 0.6 0.9 0.6 0.9 0.6 0.9 0.6 0.9 1")