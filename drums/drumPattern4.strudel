// "house drums - normal"
// @by hvgo

setcpm(120/4)
all(x => x.postgain(.9))

$kick: s("bd:6")
  .beat(`<[0,1,2,3]!7 [0,1,1.8,2,2.5,3]>`,4).clip(.5).resonance(.3).gain(.8).duck("2:3:4")
  .duckatt("0.2")

$hh: s("hh:1*16").velocity("0.8 0.5 0.7 0.8 0.5 0.7 0.6 0.3 0.7 1").delay(.3)

$snare: s("sd:8").beat("1,3", 4).clip(.7).velocity(.8).gain(.8)

_$clap: s("cp:4").beat("0.97,2.97", 4).gain(.7).clip(.3)

_$hatOfftempo: s("hh:10").beat("1,3,5,7",8).gain(.6)

$sub: s("sine").note("g1 g1 g1 g1").beat("0,1,2,3",4).orbit(2).clip(1)

$riser: 
s("pulse").fm(time).fmh(time).hpf(3000).room(.3).seg(16).gain(.5).clip(.3).orbit(3)

