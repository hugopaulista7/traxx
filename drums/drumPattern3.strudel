// "electro break drums 3"
// @by hvgo

const bankName = "TR808"


$kick: bank(bankName).s("bd:3").beat("0,3,4.5,5",8).duck(2)

$snare: bank(bankName).s("sd:4").beat("2,6",8)

_$cowbell: bank(bankName).s("cb")
  .beat("3,4,5",16)
.gain(.6)


$hh: bank(bankName).s("hh").beat("0,1,3,4,6,7,9,10,12,13,15",16).gain(.7)
.velocity("0.7 0.5 0.8 0.7 0.5 0.8 0.7 0.5 0.8 1")


$sub: s("sine").note("g1 g1").beat("0,3,4.5,5",8).clip(2).gain(.7).orbit(2)
